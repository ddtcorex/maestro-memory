{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @ddtcorex/maestro-memory@5.1.0 maestro-memory-hook session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @ddtcorex/maestro-memory@5.1.0 maestro-memory-hook session-end",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
