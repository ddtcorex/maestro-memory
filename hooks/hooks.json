{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y -p @ddtcorex/maestro-memory@5.2.0 maestro-memory-hook session-start 2>/dev/null",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y -p @ddtcorex/maestro-memory@5.2.0 maestro-memory-hook session-end 2>/dev/null",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
